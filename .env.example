# SQLite persistence
BLUEOCEAN_SQLITE_PATH=data/blueocean.db

# Maximum time to wait for MT5 initialization/login (seconds)
BLUEOCEAN_MT5_STARTUP_TIMEOUT_SECONDS=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BLUEOCEAN_SECRET_KEY=replace-with-generated-fernet-key
