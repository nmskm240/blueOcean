@startuml

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package domain {
    class AccountId <<dataclass>> {
        +value: str
        +create(): AccountId
    }

    class Mt5Connection <<dataclass>> {
        +path: str
        +server: str
        +login: int
        +encrypted_password: bytes
        +__post_init__(): void
    }

    class Account {
        +id: AccountId
        +name: str
        +connection: Mt5Connection
        +portable: bool
        +has_password: bool
    }

    class AccountNotFoundError <<exception>>

    interface IAccountRepository {
        +list(): list<Account>
        +get_by_id(id: AccountId): Account
        +save(account: Account): AccountId
        +delete_by_id(id: AccountId): void
    }
}

package persistence {
    class AccountSchema <<Peewee Model>> {
        +id: CharField
        +name: CharField
        +path: CharField
        +login: IntegerField
        +password_encrypted: BlobField
        +server: CharField
        +portable: BooleanField
        +created_at: DateTimeField
        +updated_at: DateTimeField
        +to_entity(): Account
    }

    class MT5AccountRepository {
        -database: SqliteDatabase
        +list(): list<Account>
        +get_by_id(id: AccountId): Account
        +save(account: Account): AccountId
        +delete_by_id(id: AccountId): void
    }
}

package api {
    class AccountInput <<Pydantic>> {
        +name: str
        +path: str
        +login: int | None
        +server: str
        +portable: bool
    }

    class AccountCreate <<Pydantic>> {
        +password: SecretStr
    }

    class AccountUpdate <<Pydantic>> {
        +password: SecretStr | None
    }

    class AccountOutput <<Pydantic>> {
        +id: str
        +name: str
        +path: str
        +login: int | None
        +server: str
        +portable: bool
        +has_password: bool
    }
}

package "usecases.py" as usecases {
    class CreateAccountInput <<dataclass>> {
        +name: str
        +path: str
        +login: int | None
        +password: str
        +server: str
        +portable: bool
    }

    class UpdateAccountInput <<dataclass>> {
        +account_id: AccountId
        +name: str
        +path: str
        +login: int | None
        +password: str | None
        +server: str
        +portable: bool
    }

    class CreateAccountUseCase {
        -_repository: IAccountRepository
        -_cipher: Fernet
        +execute(input: CreateAccountInput): Account
    }

    class ListAccountsUseCase {
        -_repository: IAccountRepository
        +execute(): list<Account>
    }

    class UpdateAccountUseCase {
        -_repository: IAccountRepository
        -_cipher: Fernet
        +execute(input: UpdateAccountInput): Account
    }

    class DeleteAccountUseCase {
        -_repository: IAccountRepository
        -_manager: MT5WorkerManager
        +execute(account_id: AccountId): void
    }

    class GetAccountUseCase {
        -_repository: IAccountRepository
        +execute(account_id: AccountId): Account
    }

    class StartMT5WorkerUseCase {
        -_repository: IAccountRepository
        -_cipher: Fernet
        -_manager: MT5WorkerManager
        +execute(account_id: AccountId): WorkerStatus
    }

    class StopMT5WorkerUseCase {
        -_manager: MT5WorkerManager
        +execute(account_id: AccountId): WorkerStatus
    }

    class AccountWorkerActiveError <<exception>>
}

package configuration {
    class Settings <<Pydantic Settings>> {
        +sqlite_path: Path
        +mt5_secret_key: SecretStr
        +mt5_startup_timeout_seconds: float
    }

    class SettingsModule <<Injector Module>> {
        -settings: Settings
        +configure(binder: Binder): void
    }

    class DatabaseModule <<Injector Module>> {
        +database(settings: Settings): SqliteDatabase
        +account_repository(database: SqliteDatabase): IAccountRepository
    }

    class SecurityModule <<Injector Module>> {
        +password_cipher(settings: Settings): Fernet
    }

    class MT5Module <<Injector Module>> {
        +mt5_worker_manager(settings: Settings): MT5WorkerManager
    }

    class StrategyModule <<Injector Module>> {
        +strategy_repository(): StrategyRepository
        +strategy_run_repository(): StrategyRunRepository
        +strategy_supervisor(...): StrategySupervisor
    }
}

package metatrader {
    class MT5ConnectionError <<exception>>

    class MT5Client {
        +mt5: Any
        +path: str | None
        +login: int | None
        +password: str | None
        +server: str | None
        +timeout: int
        +portable: bool
        +connect(): void
        +shutdown(): void
        +last_error(): Any
        +ensure_symbol(symbol: str): Any
        +copy_rates_from_pos(symbol: str, timeframe: int, start: int, count: int)
        +symbol_info_tick(symbol: str)
        +account_info()
        +positions_get(symbol: str | None)
        +order_send(request: dict[str, Any])
        +timeframe(name: str): int
    }

    class MT5Store {
        +client: MT5Client
        -_users: int
        -_lock: RLock
        +start(): void
        +stop(): void
        +getdata(**kwargs): MT5Data
        +getbroker(**kwargs): MT5Broker
    }

    class MT5Data <<Backtrader DataBase>> {
        -_store: MT5Store
        -_symbol: str
        -_rows: list<Any>
        -_last_time: int
        -_next_poll: float
        -_timeframe: int
        +islive(): bool
        +start(): void
        +stop(): void
        -_load()
    }

    class MT5Broker <<Backtrader BrokerBase>> {
        -_store: MT5Store
        -_notifications: deque
        -_orders: dict<int, Order>
        +start(): void
        +stop(): void
        +getcash(): float
        +getvalue(datas=None): float
        +getposition(data, clone=True)
        +buy(owner, data, size, price=None, plimit=None, exectype=None, **kwargs)
        +sell(owner, data, size, price=None, plimit=None, exectype=None, **kwargs)
        +submit(order, check=True)
        +cancel(order)
        +get_notification()
        -_transmit(order)
        -_order_type(order, mt5)
        -_notify(order): void
    }

    class WorkerStatus <<dataclass>> {
        +state: str
        +pid: int | None
        +error: str | None
    }

    class MT5WorkerManager {
        -_workers: dict<str, WorkerHandle>
        -_startup_timeout: float
        +start(account_id: str, connection: dict): WorkerStatus
        +stop(account_id: str): WorkerStatus
        +get_status(account_id: str): WorkerStatus
        +get_statuses(): dict<str, WorkerStatus>
        +stop_all(): void
    }
}

package strategy {
    class StrategyConfig <<dataclass>> {
        +id: str
        +name: str
        +definition_key: str
        +account_id: str
        +symbol: str
        +timeframe: str
        +mode: str
        +parameters: dict
    }

    class StrategyRun <<dataclass>> {
        +id: str
        +strategy_id: str
        +state: str
        +pid: int | None
        +error: str | None
        +started_at: datetime
        +heartbeat_at: datetime | None
        +stopped_at: datetime | None
    }

    class ParameterDefinition <<dataclass>> {
        +name: str
        +label: str
        +value_type: type
        +default: Any
        +minimum: float | None
        +parse(value): Any
    }

    class StrategyDefinition <<dataclass>> {
        +key: str
        +label: str
        +strategy_class: type
        +parameters: tuple<ParameterDefinition>
        +validate(values: dict): dict
    }

    class StrategyRegistry <<registry>> {
        +register_strategy(...): decorator
        +get_strategy_definition(key): StrategyDefinition
    }

    class DummyHeartbeatStrategy <<Backtrader Strategy>>
    class MovingAverageCrossStrategy <<Backtrader Strategy>> {
        +next(): void
    }

    class StrategyRepository {
        +list(): list<StrategyConfig>
        +get(strategy_id: str): StrategyConfig
        +save(strategy: StrategyConfig): StrategyConfig
    }

    class StrategyRunRepository {
        +list(): list<StrategyRun>
        +get(run_id: str): StrategyRun
        +active_for_strategy(strategy_id: str): StrategyRun | None
        +save(run: StrategyRun): StrategyRun
        +mark_active_lost(): void
    }

    class StrategySchema <<Peewee Model>>
    class StrategyRunSchema <<Peewee Model>>

    class RunnerEvent <<dataclass>> {
        +kind: str
        +occurred_at: datetime
        +error: str | None
    }

    class SyntheticLiveData <<Backtrader DataBase>> {
        -_load()
    }

    class StrategySupervisor {
        -_handles: dict<str, RunHandle>
        +reconcile(): void
        +start(strategy_id: str): StrategyRun
        +stop(run_id: str): StrategyRun
        +stop_all(): void
    }

    class StrategyService {
        -_strategies: StrategyRepository
        -_runs: StrategyRunRepository
        -_supervisor: StrategySupervisor
        +definitions(): list<StrategyDefinition>
        +list_strategies(): list<StrategyConfig>
        +get_strategy(strategy_id: str): StrategyConfig
        +create_strategy(command): StrategyConfig
        +list_runs(): list<StrategyRun>
        +get_run(run_id: str): StrategyRun
        +start_run(strategy_id: str): StrategyRun
        +stop_run(run_id: str): StrategyRun
    }

    class BacktraderRunner <<process function>> {
        +run_backtrader_strategy(config, stop_event, status_queue): void
    }

    class StrategyAlreadyRunningError <<exception>>
    class StrategyNotFoundError <<exception>>
    class StrategyRunNotFoundError <<exception>>
}

Account *-- AccountId
Account *-- Mt5Connection
IAccountRepository ..> Account
IAccountRepository ..> AccountId
IAccountRepository ..> AccountNotFoundError : raises

MT5AccountRepository ..|> IAccountRepository
MT5AccountRepository --> AccountSchema : reads/writes
MT5AccountRepository ..> Account : maps
MT5AccountRepository ..> AccountId
MT5AccountRepository ..> AccountNotFoundError : raises
AccountSchema ..> Account : to_entity()
AccountSchema ..> Mt5Connection : creates
AccountSchema ..> AccountId : creates

AccountCreate --|> AccountInput
AccountUpdate --|> AccountInput
AccountOutput ..> Account : built from
AccountInput ..> CreateAccountInput : maps to
AccountInput ..> UpdateAccountInput : maps to
CreateAccountInput ..> CreateAccountUseCase : payload for
UpdateAccountInput ..> UpdateAccountUseCase : payload for

CreateAccountUseCase --> IAccountRepository : uses
CreateAccountUseCase --> Account : creates/returns
CreateAccountUseCase --> Mt5Connection : creates
CreateAccountUseCase ..> Fernet : encrypts password
ListAccountsUseCase --> IAccountRepository : uses
ListAccountsUseCase --> Account : returns
UpdateAccountUseCase --> IAccountRepository : uses
UpdateAccountUseCase --> Account : creates/returns
UpdateAccountUseCase --> Mt5Connection : creates
UpdateAccountUseCase --> AccountId : uses
UpdateAccountUseCase ..> AccountNotFoundError : raises
UpdateAccountUseCase ..> Fernet : encrypts password
DeleteAccountUseCase --> IAccountRepository : uses
DeleteAccountUseCase --> AccountId : uses
DeleteAccountUseCase ..> AccountNotFoundError : raises
DeleteAccountUseCase --> MT5WorkerManager : checks active state
GetAccountUseCase --> IAccountRepository : uses
StartMT5WorkerUseCase --> IAccountRepository : loads credentials
StartMT5WorkerUseCase --> MT5WorkerManager : starts
StopMT5WorkerUseCase --> MT5WorkerManager : stops
UpdateAccountUseCase --> MT5WorkerManager : checks active state
UpdateAccountUseCase ..> AccountWorkerActiveError : raises
DatabaseModule ..> Settings
DatabaseModule ..> MT5AccountRepository : provides
DatabaseModule ..> IAccountRepository : binds
SecurityModule ..> Settings
MT5Module ..> Settings
MT5Module ..> MT5WorkerManager : provides
StrategyModule ..> StrategyRepository : provides
StrategyModule ..> StrategyRunRepository : provides
StrategyModule ..> StrategySupervisor : provides
SettingsModule *-- Settings

MT5Store *-- MT5Client
MT5Store ..> MT5Data : creates
MT5Store ..> MT5Broker : creates
MT5Client ..> MT5ConnectionError : raises
MT5Data --> MT5Store : uses shared connection
MT5Broker --> MT5Store : uses shared connection

MT5Data --|> backtrader.DataBase
MT5Broker --|> backtrader.BrokerBase
MT5WorkerManager ..> WorkerStatus : returns
MT5WorkerManager ..> MT5Client : child process owns

StrategyConfig --> StrategyDefinition : definition_key
StrategyConfig --> Account : account_id
StrategyRun --> StrategyConfig : strategy_id
StrategyDefinition *-- ParameterDefinition
StrategyDefinition --> backtrader.Strategy : strategy_class
StrategyRegistry o-- StrategyDefinition
DummyHeartbeatStrategy --|> backtrader.Strategy
MovingAverageCrossStrategy --|> backtrader.Strategy
StrategyRepository --> StrategySchema : reads/writes
StrategyRepository ..> StrategyConfig : maps
StrategyRunRepository --> StrategyRunSchema : reads/writes
StrategyRunRepository ..> StrategyRun : maps
StrategySupervisor --> StrategyRepository
StrategySupervisor --> StrategyRunRepository
StrategySupervisor ..> BacktraderRunner : spawns
StrategySupervisor ..> StrategyAlreadyRunningError : raises
StrategyService --> StrategyRepository
StrategyService --> StrategyRunRepository
StrategyService --> StrategySupervisor
StrategyService ..> StrategyConfig : creates/returns
StrategyService ..> StrategyRun : returns
BacktraderRunner --> StrategyRegistry : resolves class
BacktraderRunner --> SyntheticLiveData : creates
BacktraderRunner --> backtrader.Cerebro : configures/runs
BacktraderRunner ..> RunnerEvent : emits
SyntheticLiveData --|> backtrader.DataBase
SyntheticLiveData ..> RunnerEvent : heartbeat

note right of Mt5Connection
  Validates an absolute local MT5 terminal path,
  a non-empty server, a positive integer login,
  and encrypted password bytes.
end note

note right of MT5Store
  Reference-counts one MT5 terminal connection
  shared by Backtrader feeds and broker instances.
end note

note right of MT5Broker
  Supports Backtrader Market, Limit, and Stop orders
  by translating them into MT5 order_send requests.
end note

note right of StrategyConfig
  Persistent configuration only.
  It deliberately does not inherit bt.Strategy.
end note

note right of BacktraderRunner
  Current MVP uses SyntheticLiveData in paper mode.
  Redis closed-bar feed replaces it in Phase 4.
end note

@enduml
